<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(WinxCoopBundleDesktopRuntime)' != 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(WinxCoopBundleDesktopRuntime)' == 'true'">net8.0-windows</TargetFramework>
    <AssemblyName>WinxCoop.ActorProbe</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- Bundle-only runtime alignment. Keep this a console program and avoid
       UseWindowsForms, its implicit imports and its WinExe inference. -->
  <ItemGroup Condition="'$(WinxCoopBundleDesktopRuntime)' == 'true'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src/RuntimeProbe/**/*.cs" />
    <ProjectReference Include="../SmoViewer/SmoNativeValidator.Core/SmoNativeValidator.Core.csproj" />
  </ItemGroup>
</Project>
