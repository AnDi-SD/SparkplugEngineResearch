<Project>
  <PropertyGroup>
    <WinxCoopTargetFramework Condition="'$(WinxCoopTargetFramework)' == ''">net8.0</WinxCoopTargetFramework>
    <WinxCoopPlatform Condition="'$(WinxCoopPlatform)' == ''">x64</WinxCoopPlatform>
    <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/$(WinxCoopTargetFramework)/$(WinxCoopPlatform)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(MSBuildProjectName)/$(WinxCoopPlatform)/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WinxCoopTargetFramework)</TargetFramework>
    <AssemblyName>WinxCoop.SessionRuntimeChecks</AssemblyName>
    <PlatformTarget>$(WinxCoopPlatform)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(WinxCoopTargetFramework)' == 'net6.0'">win-$(WinxCoopPlatform)</RuntimeIdentifier>
    <RuntimeFrameworkVersion Condition="'$(WinxCoopTargetFramework)' == 'net6.0'">6.0.36</RuntimeFrameworkVersion>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <CheckEolTargetFramework Condition="'$(WinxCoopTargetFramework)' == 'net6.0'">false</CheckEolTargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="tests/SessionRuntimeChecks/*.cs" />
    <Compile Include="src/SessionHost/SessionConfiguration.cs" />
    <Compile Include="src/SessionHost/SessionLifecycleBudget.cs" />
    <Compile Include="src/SessionHost/RuntimeBundle.cs" />
    <Compile Include="src/SessionHost/GameSelection.cs" />
    <Compile Include="src/SessionHost/GameProfile.cs" />
    <Compile Include="src/RuntimeProbe/InteractiveSessionLimits.cs" Link="InteractiveSessionLimits.cs" />
    <Compile Include="src/RuntimeProbe/CampaignSceneProfile.cs" Link="CampaignSceneProfile.cs" />
    <ProjectReference Include="WinxCoop.SessionRuntime.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
