<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.6.1</Version>
    <AssemblyVersion>0.6.1.0</AssemblyVersion>
    <FileVersion>0.6.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmoImporter.Core\SmoImporter.Core.csproj" />
    <ProjectReference Include="..\..\SmoExporter\SmoExporter.Core\SmoExporter.Core.csproj" />
    <ProjectReference Include="..\..\SmoViewer\SmoNativeValidator.Core\SmoNativeValidator.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\FbxBridge.Native\build\bin\Release\SmoFbxBridge.exe"
             Condition="Exists('..\..\FbxBridge.Native\build\bin\Release\SmoFbxBridge.exe')"
             Link="SmoFbxBridge.exe" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\FbxBridge.Native\build\bin\Release\libfbxsdk.dll"
             Condition="Exists('..\..\FbxBridge.Native\build\bin\Release\libfbxsdk.dll')"
             Link="libfbxsdk.dll" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\FbxBridge.Native\build\bin\Release\FBX_SDK_License.rtf"
             Condition="Exists('..\..\FbxBridge.Native\build\bin\Release\FBX_SDK_License.rtf')"
             Link="FBX_SDK_License.rtf" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
