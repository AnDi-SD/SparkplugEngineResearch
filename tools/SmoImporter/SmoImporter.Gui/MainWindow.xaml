    <Viewport3D.Camera><PerspectiveCamera x:Name="Camera" Position="0,0,10" LookDirection="0,0,-10" UpDirection="0,1,0" FieldOfView="45"/></Viewport3D.Camera>
    <ModelVisual3D><ModelVisual3D.Content><AmbientLight Color="#888888"/></ModelVisual3D.Content></ModelVisual3D>
    <ModelVisual3D><ModelVisual3D.Content><DirectionalLight Color="White" Direction="-1,-1,-2"/></ModelVisual3D.Content></ModelVisual3D>
    <ModelVisual3D x:Name="SceneVisual"/>
   </Viewport3D>
   <Canvas x:Name="RigOverlayCanvas" IsHitTestVisible="False" ClipToBounds="True">
    <Rectangle x:Name="GeneratedComponentSelectionRectangle"
               Stroke="#7DD3FC" StrokeThickness="1.5" StrokeDashArray="4,2"
               Fill="#337DD3FC" Visibility="Collapsed"/>
   </Canvas>
   <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" IsHitTestVisible="False">
    <StackPanel>
     <TextBlock x:Name="BoneHighlightText" Margin="0,5,0,0" Foreground="#FF6464" TextWrapping="Wrap"
      Text="Красный — выбранная palette bone"/>
     <TextBlock x:Name="ModelTransformGizmoViewportHint" Margin="0,5,0,0"
      Visibility="Collapsed" Foreground="#FDE68A" TextWrapping="Wrap"
      Text="ЛКМ по gizmo — двигать, поворачивать или менять общий масштаб модели"/>
    </StackPanel>
   </Border>
   <Border x:Name="GeneratedCalculationOverlay"
           HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
           Margin="16" Padding="12" Background="#E6111720"
           BorderBrush="#64748B" BorderThickness="1" CornerRadius="5"
           Visibility="Collapsed">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="140"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBlock x:Name="GeneratedCalculationOverlayText"
                VerticalAlignment="Center" Foreground="White"
                Text="0% — подготовка расчёта" TextTrimming="CharacterEllipsis"/>
     <ProgressBar x:Name="GeneratedCalculationOverlayBar" Grid.Column="1"
                  Height="18" Margin="12,0" Minimum="0" Maximum="100"/>
     <Button x:Name="CancelGeneratedCalculationButton" Grid.Column="2"
             MinWidth="105" Height="30" Padding="10,0"
             Content="Остановить" Click="CancelGeneratedCalculation_Click"/>
    </Grid>
   </Border>
  </Grid>
   <TextBlock x:Name="LegacyPreviewGuidanceText" Grid.Row="1" Style="{StaticResource PreviewGuidanceStyle}"
              Text="ПКМ — вращать · Shift+ПКМ — сдвиг вида · Колесо / Ctrl+ПКМ — приблизить · Home — в кадр"/>
  </Grid>
  </Grid>

  <Border x:Name="SaveOperationOverlay" Grid.RowSpan="3" Panel.ZIndex="100"
          Background="#B3101720" Visibility="Collapsed">
   <Border HorizontalAlignment="Center" VerticalAlignment="Center"
           Width="440" Padding="22" Background="#F51F2937"
           BorderBrush="#64748B" BorderThickness="1" CornerRadius="7">
    <StackPanel>
     <TextBlock x:Name="SaveOperationStatusText" Foreground="White"
                FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                Text="Собирается и проверяется новый SMO…"/>
     <ProgressBar Height="18" Margin="0,14,0,0" IsIndeterminate="True"/>
     <Button x:Name="CancelSaveOperationButton" Style="{StaticResource WizardButtonStyle}" Margin="0,14,0,0"
             Content="Остановить безопасно" Click="CancelSaveOperation_Click"/>
    </StackPanel>
   </Border>
  </Border>

  <Border Grid.Row="2" Padding="18,10" Background="#151B23" BorderBrush="#2B3542" BorderThickness="0,1,0,0">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer x:Name="WizardFooterInfoScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ScrollViewer.Resources>
      <Style TargetType="ScrollBar" BasedOn="{StaticResource WizardScrollBarStyle}"/>
     </ScrollViewer.Resources>
    <StackPanel>
    <Border x:Name="WizardNoticePanel" Visibility="Collapsed" Padding="10,7" Margin="0,0,0,8"
            BorderThickness="1" CornerRadius="4" AutomationProperties.LiveSetting="Polite">
     <StackPanel>
      <TextBlock x:Name="WizardNoticeTitle" FontWeight="SemiBold"/>
      <TextBlock x:Name="WizardNoticeSummary" Margin="0,3,0,0" Foreground="#F1E7D5" TextWrapping="Wrap"/>
      <Expander x:Name="WizardNoticeExpander" Header="Подробности" Margin="0,4,0,0" Foreground="#F1E7D5">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Bottom" Content="Открыть журнал" Click="OpenDiagnosticLogFolder_Click"
                Style="{StaticResource WizardButtonStyle}" HorizontalAlignment="Left" Height="28" Margin="0,5,0,0"/>
        <TextBox x:Name="WizardNoticeDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                 VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#F1E7D5" BorderThickness="0"/>
       </DockPanel>
      </Expander>
     </StackPanel>
    </Border>
    <TextBlock x:Name="WizardMessageText" Margin="0,0,0,8" Foreground="#9BAABD"
               Text="Выберите исходный SMO и модель-донора." TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite"/>
    <Expander x:Name="WizardStepHelpExpander" Visibility="Collapsed" IsExpanded="False" Margin="0,0,0,8"
              Foreground="#D8DEE9" Expanded="WizardStepHelp_Expanded" Collapsed="WizardStepHelp_Collapsed"
              Unloaded="WizardStepHelp_Unloaded" AutomationProperties.Name="Инструкция по текущему шагу">
     <Expander.Header>
      <TextBlock x:Name="WizardStepHelpHeader" Text="Инструкция по шагу" Foreground="#FFD3A1" FontWeight="SemiBold"/>
     </Expander.Header>
     <Border Margin="0,6,0,0" Padding="10,7" Background="#10161E" BorderBrush="#344354" BorderThickness="1" CornerRadius="4">
      <ScrollViewer x:Name="WizardStepHelpScroll" MaxHeight="144" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ScrollViewer.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource WizardScrollBarStyle}"/>
       </ScrollViewer.Resources>
       <StackPanel>
        <StackPanel x:Name="WizardStepHelpContent"/>
        <TextBlock x:Name="WizardStepHelpFeedback" Visibility="Collapsed" Margin="0,6,0,0" FontSize="11"
                   Foreground="#FFD3A1" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Expander>
    </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="1" LastChildFill="False">
     <Button x:Name="WizardBackButton" DockPanel.Dock="Left" Style="{StaticResource WizardButtonStyle}"
             Content="Назад" IsEnabled="False" ToolTip="Вернуться к предыдущему шагу."
             Click="WizardBack_Click"/>
     <Button x:Name="WizardUndoButton" DockPanel.Dock="Left" Style="{StaticResource WizardButtonStyle}"
             Margin="8,0,0,0" Content="Отменить" IsEnabled="False"
             ToolTip="Отменить выбор файла, переход, смену режима или текстур." Click="WizardUndo_Click"/>
     <Button x:Name="WizardRedoButton" DockPanel.Dock="Left" Style="{StaticResource WizardButtonStyle}"
             Margin="8,0,0,0" Content="Повторить" IsEnabled="False"
             ToolTip="Повторить отменённый выбор, переход или настройку." Click="WizardRedo_Click"/>
     <Button x:Name="WizardCancelLoadButton" DockPanel.Dock="Left" Style="{StaticResource WizardButtonStyle}"
             Margin="8,0,0,0" Content="Отменить загрузку" Visibility="Collapsed"
             ToolTip="Запросить отмену. Чтение текущего блока файла должно завершиться перед освобождением данных."
             Click="WizardCancelLoad_Click"/>
     <Button x:Name="WizardNextButton" DockPanel.Dock="Right" Style="{StaticResource WizardButtonStyle}"
             Content="Далее" IsEnabled="False" Background="#50351F" BorderBrush="#8C5A2D"
             Foreground="#FFD3A1" ToolTip="Перейти к следующему шагу после загрузки обеих моделей."
             Click="WizardNext_Click"/>
    </DockPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
