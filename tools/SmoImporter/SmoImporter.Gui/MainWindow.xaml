                      Margin="0,4" Minimum="-100" Maximum="100" Value="0"
                      VerticalAlignment="Center"
                      ValueChanged="ProtectedRegionSlider_ValueChanged"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Margin="6,4,0,4"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding ElementName=ProtectedRegionPositionSlider, Path=Value, StringFormat={}{0:F2}}"/>

              <TextBlock Grid.Row="1" Margin="0,4,6,4" VerticalAlignment="Center"
                         FontSize="12" Text="Длина"/>
