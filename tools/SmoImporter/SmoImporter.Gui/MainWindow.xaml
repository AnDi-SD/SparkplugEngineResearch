           <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Source, ElementName=TextureFocusImage}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </Border>
      </Grid>
     </Border>
      <Border x:Name="WizardProtectionProgressPanel" Visibility="Collapsed" Padding="9" Margin="12"
              HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Panel.ZIndex="10"
              BorderBrush="#536176" BorderThickness="1" Background="#F21B2532" CornerRadius="4">
       <StackPanel>
        <TextBlock x:Name="WizardProtectionProgressText" Foreground="#DCE3EA" TextWrapping="Wrap"/>
        <ProgressBar x:Name="WizardProtectionProgressBar" Minimum="0" Maximum="100" Height="12" Margin="0,7,0,0"/>
        <WrapPanel Margin="0,7,0,0">
         <Button x:Name="WizardProtectionCancelButton" Style="{StaticResource WizardButtonStyle}" Margin="0,0,6,0"
                 Content="Отменить расчёт" Click="WizardProtectionCancel_Click"/>
         <Button x:Name="WizardProtectionRetryButton" Style="{StaticResource WizardButtonStyle}"
                 Content="Повторить расчёт" Click="WizardProtectionRetry_Click"/>
        </WrapPanel>
       </StackPanel>
      </Border>
     </Grid>
     <TextBlock x:Name="DonorPreviewGuidanceText" Grid.Row="4" Style="{StaticResource PreviewGuidanceStyle}"
                Text="Выберите донора или перетащите модель сюда."/>
    </Grid>
   </Border>
  </Grid>

  <!-- Fitting and save controls belong to a separate stage. -->
