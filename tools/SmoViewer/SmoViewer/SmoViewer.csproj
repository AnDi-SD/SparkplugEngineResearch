<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>SmoViewer.App</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <BuildDateUtc Condition="'$(BuildDateUtc)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildDateUtc>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDateUtc</_Parameter1>
      <_Parameter2>$(BuildDateUtc)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy OpenTK prototype retained in source for research history, but it is
         not part of the current WPF application or its dependency graph. -->
    <Compile Remove="MeshPart.cs;MeshPartItem.cs;ModelData.cs;Program.cs;ShaderHelper.cs;SmoLoader.cs;ViewerWindow.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmoViewer.Core\SmoViewer.Core.csproj" />
    <ProjectReference Include="..\SmoNativeValidator.Core\SmoNativeValidator.Core.csproj" />
  </ItemGroup>

</Project>
