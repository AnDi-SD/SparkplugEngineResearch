<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>SmoViewer.App</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <BuildDateUtc Condition="'$(BuildDateUtc)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildDateUtc>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDateUtc</_Parameter1>
      <_Parameter2>$(BuildDateUtc)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmoViewer.Core\SmoViewer.Core.csproj" />
    <ProjectReference Include="..\SmoViewer.Sparkplug\SmoViewer.Sparkplug.csproj" />
    <ProjectReference Include="..\SmoViewer.Scene\SmoViewer.Scene.csproj" />
    <ProjectReference Include="..\SmoViewer.Rendering.Wpf\SmoViewer.Rendering.Wpf.csproj" />
    <ProjectReference Include="..\SmoNativeValidator.Core\SmoNativeValidator.Core.csproj" />
  </ItemGroup>

</Project>
