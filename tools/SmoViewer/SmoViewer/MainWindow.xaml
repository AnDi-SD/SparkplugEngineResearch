<Window x:Class="SmoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmoViewer"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="SMO Viewer"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        Background="#17191F"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Deactivated="Window_Deactivated"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,8"
                Background="#242832"
                BorderBrush="#343946"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="AboutButton"
                        DockPanel.Dock="Right"
                        MinWidth="108"
                        Margin="10,0,0,0"
                        Padding="12,6"
                        Click="About_Click"
                        Content="О программе" />
                <Button x:Name="OpenSmoButton"
                        DockPanel.Dock="Left"
                        MinWidth="132"
                        Padding="14,6"
                        Click="OpenSmo_Click"
                        Content="Открыть SMO" />
                <Button x:Name="LaunchExporterButton"
                        DockPanel.Dock="Left"
                        MinWidth="112"
                        Margin="8,0,0,0"
                        Padding="14,6"
                        IsEnabled="False"
                        Click="LaunchExporter_Click"
                        Content="Экспорт…" />
                <Button x:Name="LaunchImporterButton"
                        DockPanel.Dock="Left"
                        MinWidth="112"
                        Margin="8,0,0,0"
                        Padding="14,6"
                        IsEnabled="False"
                        Click="LaunchImporter_Click"
                        Content="Импорт…" />
                <StackPanel DockPanel.Dock="Left"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               Foreground="#D8DCE4"
                               Text="Камера:" />
                    <ComboBox x:Name="CameraModeSelector"
                              Width="132"
                              Padding="6,4"
                              SelectedIndex="0"
                              SelectionChanged="CameraModeSelector_SelectionChanged">
                        <ComboBoxItem Content="Blender" Tag="Orbit" />
                        <ComboBoxItem Content="Полёт" Tag="Fly" />
                    </ComboBox>
                    <Button x:Name="CameraHelpIcon"
                            Width="22"
                            Height="22"
                            Margin="7,0,0,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Foreground="#D8DCE4"
                            FontWeight="SemiBold"
                            Content="?"
                            Cursor="Help"
                            Focusable="False"
                            IsTabStop="False"
                            ToolTipService.InitialShowDelay="250"
                            ToolTipService.ShowDuration="30000"
                            AutomationProperties.Name="Подсказка по управлению камерой">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="HelpButtonBorder"
                                        Background="#343946"
                                        BorderBrush="#596273"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HelpButtonBorder" Property="Background" Value="#465061" />
                                        <Setter TargetName="HelpButtonBorder" Property="BorderBrush" Value="#8D9AAF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="190" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    ClipToBounds="True"
                    Background="#1B1F27"
                    BorderBrush="#343946"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <UniformGrid DockPanel.Dock="Top" Rows="1" Background="#242832">
                        <Button Padding="5,7" Click="ShowResourcesPanel_Click" Content="Ресурсы"/>
                        <Button x:Name="GuiPanelButton"
                                Padding="5,7"
                                Click="GuiPanelButton_Click"
                                Content="2D / GUI"
                                ToolTip="Плоская GUI-сцена распознана структурно"
                                Visibility="Collapsed"/>
                        <Button x:Name="SkeletonPanelButton"
                                Padding="5,7"
                                Click="SkeletonPanelButton_Click"
                                Content="Слои"/>
                        <Button Padding="5,7" Click="AnimationPanelButton_Click" Content="Анимации"/>
                        <Button Padding="5,7"
                                Click="NativeValidationPanelButton_Click"
                                Content="Игра"
                                ToolTip="Нативная проверка модели" />
                    </UniformGrid>
                    <Grid>
                        <DockPanel x:Name="ResourcesPanel">
                            <TextBlock DockPanel.Dock="Top" Padding="10,7" Background="#242832" Foreground="#D8DCE4" FontWeight="SemiBold" Text="Структура SMO"/>
                            <TreeView x:Name="SceneTree" Padding="3" Background="#1B1F27" BorderThickness="0" Foreground="#D8DCE4" SelectedItemChanged="SceneTree_SelectedItemChanged" MouseDoubleClick="SceneTree_MouseDoubleClick"/>
                        </DockPanel>
                        <DockPanel x:Name="SkeletonPanel" Margin="10" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#F0F2F6" FontSize="16" FontWeight="SemiBold" Text="Слои просмотра"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <StackPanel Margin="0,0,5,0">
                                    <CheckBox x:Name="ShowSkeletonCheck" Foreground="#D8DCE4" IsChecked="True" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Отобразить скелет"/>
                                    <CheckBox x:Name="ShowAttachmentsCheck" Margin="0,6,0,0" Foreground="#D8DCE4" IsChecked="True" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Показать точки привязки"/>
                                    <CheckBox x:Name="ShowCollisionCheck" Margin="0,6,0,0" Foreground="#D8DCE4" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Показать коллизии"/>
                                    <CheckBox x:Name="ShowControlRigCheck" Margin="0,6,0,0" Foreground="#D8DCE4" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Показать control / IK rig"/>
                                    <CheckBox x:Name="ShowMarkersCheck" Margin="0,6,0,0" Foreground="#D8DCE4" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Показать служебные маркеры"/>
                                    <CheckBox x:Name="HighlightInfluencedMeshesCheck" Margin="0,6,0,9" Foreground="#D8DCE4" IsChecked="True" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Подсвечивать mesh выбранной кости"/>
                                    <Separator Margin="0,2,0,8" Background="#343946"/>
                                    <TextBlock Margin="0,0,0,5" Foreground="#F0F2F6" FontWeight="SemiBold" Text="Оформление сцены"/>
                                    <CheckBox x:Name="ShowFloorGridCheck" Margin="0,0,0,7" Foreground="#D8DCE4" IsChecked="True" Checked="FloorGridOption_Changed" Unchecked="FloorGridOption_Changed" Content="Показать сетку пола"/>
                                    <TextBlock Margin="0,0,0,4" Foreground="#D8DCE4" Text="Сглаживание"/>
                                    <ComboBox x:Name="GpuAntialiasingCombo"
                                              Margin="0,0,0,8"
                                              SelectedIndex="2"
                                              SelectionChanged="GpuAntialiasingCombo_SelectionChanged">
                                        <ComboBoxItem Tag="0" Content="Выкл."/>
                                        <ComboBoxItem Tag="2" Content="MSAA 2×"/>
                                        <ComboBoxItem Tag="4" Content="MSAA 4× (по умолчанию)"/>
                                        <ComboBoxItem Tag="8" Content="MSAA 8×"/>
                                    </ComboBox>
                                    <CheckBox x:Name="NativeLightTurntableCheck"
                                              Margin="0,0,0,5"
                                              Foreground="#D8DCE4"
                                              Checked="NativeLightTurntable_Changed"
                                              Unchecked="NativeLightTurntable_Changed"
                                              Content="Поворот модели"
                                              ToolTip="Диагностический turntable: поворачивает модель вокруг вертикальной оси. Это не эмуляция освещения игры."/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="NativeLightTurntableSlider"
                                                Minimum="-180"
                                                Maximum="180"
                                                Value="0"
                                                IsEnabled="False"
                                                ValueChanged="NativeLightTurntableSlider_ValueChanged"/>
                                        <TextBlock x:Name="NativeLightTurntableValueText"
                                                   Grid.Column="1"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#AEB5C2"
                                                   TextAlignment="Right"
                                                   Text="0°"/>
                                    </Grid>
                                    <TextBlock Margin="0,0,0,7"
                                               Foreground="#9FA8B8"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="OpenGL-preview передаёт записанные texture и vertex diffuse без модели игрового освещения; поворот нужен только для осмотра геометрии."/>
                                    <Button Margin="0,0,0,6" Padding="7,5" HorizontalContentAlignment="Left" Click="BackgroundColor_Click" ToolTip="Выбрать цвет фона сцены">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="BackgroundColorSwatch" Width="22" Height="16" Margin="0,0,8,0" Background="#11141A" BorderBrush="#8992A3" BorderThickness="1" CornerRadius="2"/>
                                            <TextBlock x:Name="BackgroundColorText" VerticalAlignment="Center" Text="Фон · #11141A"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,0,9" Padding="7,5" HorizontalContentAlignment="Left" Click="FloorGridColor_Click" ToolTip="Выбрать цвет линий сетки">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="FloorGridColorSwatch" Width="22" Height="16" Margin="0,0,8,0" Background="#596273" BorderBrush="#8992A3" BorderThickness="1" CornerRadius="2"/>
                                            <TextBlock x:Name="FloorGridColorText" VerticalAlignment="Center" Text="Сетка · #596273"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Foreground="#9FA8B8" TextWrapping="Wrap" Text="Кость выбирается глобально; строки palette показывают локальные slots каждого spSkin."/>
                                    <TextBox x:Name="BoneFilterBox" Margin="0,9,0,7" Padding="6,4" TextChanged="BoneFilter_Changed" ToolTip="Фильтр по имени кости или palette"/>
                                    <ListBox x:Name="BoneList" Height="260" Background="#171A20" BorderBrush="#343946" Foreground="#E5E8EE" DisplayMemberPath="Display" SelectionChanged="BoneList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                    <Expander Margin="0,8,0,8" Foreground="#D8DCE4" Header="Служебные объекты">
                                        <ListBox x:Name="AuxiliaryObjectList" MaxHeight="125" Background="#171A20" BorderBrush="#343946" Foreground="#C9D0DC" DisplayMemberPath="Display" SelectionChanged="AuxiliaryObjectList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                        <DockPanel x:Name="AnimationPanel" Margin="10" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#F0F2F6" FontSize="16" FontWeight="SemiBold" Text="Анимации"/>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="AnimationSourceText" Foreground="#9FA8B8" TextWrapping="Wrap" Text="Анимации будут найдены рядом с открытой моделью."/>
                                <WrapPanel Margin="0,8,0,8">
                                    <Button Padding="8,4" Margin="0,0,6,5" Click="AddAnimationFiles_Click" Content="Добавить…"/>
                                    <Button Padding="8,4" Margin="0,0,0,5" Click="ChooseAnimationFolder_Click" Content="Папка…"/>
                                </WrapPanel>
                                <TextBox x:Name="AnimationFilterBox" Margin="0,0,0,7" Padding="6,4" TextChanged="AnimationFilter_Changed" ToolTip="Фильтр по имени клипа или ANM-состоянию"/>
                                <Expander Margin="0,0,0,7" Foreground="#D8DCE4" Header="Наборы анимаций">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,5">
                                            <Button Padding="6,2" Margin="0,0,5,0" Click="EnableAllAnimationGroups_Click" Content="Все"/>
                                            <Button Padding="6,2" Click="DisableAllAnimationGroups_Click" Content="Ничего"/>
                                        </WrapPanel>
                                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="AnimationGroupsPanel"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Expander>
                            </StackPanel>
                            <ListBox x:Name="AnimationList" Background="#171A20" BorderBrush="#343946" Foreground="#E5E8EE" DisplayMemberPath="Display" SelectionChanged="AnimationList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                        <DockPanel x:Name="GuiPanel" Margin="10" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       Foreground="#F0F2F6"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="2D / GUI"/>
                            <StackPanel DockPanel.Dock="Top">
                                <Border Margin="0,0,0,9"
                                        Padding="8"
                                        Background="#202A36"
                                        BorderBrush="#3E5269"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock x:Name="GuiSummaryText"
                                               Foreground="#C9D7E8"
                                               TextWrapping="Wrap"
                                               Text="GUI-сцена не загружена."/>
                                </Border>
                                <TextBlock Margin="0,0,0,4"
                                           Foreground="#D8DCE4"
                                           FontWeight="SemiBold"
                                           Text="Экран / корневая ветвь"/>
                                <ComboBox x:Name="GuiGroupSelector"
                                          Margin="0,0,0,9"
                                          Padding="6,4"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="GuiGroupSelector_SelectionChanged"/>
                                <TextBlock Margin="0,0,0,4"
                                           Foreground="#D8DCE4"
                                           FontWeight="SemiBold"
                                           Text="Состояние контролов"/>
                                <ComboBox x:Name="GuiStateSelector"
                                          Margin="0,0,0,9"
                                          Padding="6,4"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="GuiStateSelector_SelectionChanged"/>
                                <CheckBox x:Name="GuiOrthographicCheck"
                                          Margin="0,0,0,6"
                                          Foreground="#D8DCE4"
                                          IsChecked="True"
                                          Checked="GuiOrthographicCheck_Changed"
                                          Unchecked="GuiOrthographicCheck_Changed"
                                          Content="Ортографическая 2D-камера"/>
                                <CheckBox x:Name="GuiCollisionCheck"
                                          Margin="0,0,0,8"
                                          Foreground="#D8DCE4"
                                          Checked="GuiFilter_Changed"
                                          Unchecked="GuiFilter_Changed"
                                          Content="Показать GUICollision"/>
                                <Button Margin="0,0,0,9"
                                        Padding="8,5"
                                        HorizontalContentAlignment="Left"
                                        Click="FrameGuiPreview_Click"
                                        Content="Вписать выбранный экран"/>
                                <TextBlock x:Name="GuiTextStatusText"
                                           Margin="0,0,0,9"
                                           Foreground="#E6B86A"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <Separator Margin="0,0,0,8" Background="#343946"/>
                                <TextBlock Margin="0,0,0,5"
                                           Foreground="#D8DCE4"
                                           FontWeight="SemiBold"
                                           Text="Отображаемые mesh-элементы"/>
                            </StackPanel>
                            <ListBox x:Name="GuiElementList"
                                     Background="#171A20"
                                     BorderBrush="#343946"
                                     Foreground="#E5E8EE"
                                     DisplayMemberPath="Display"
                                     SelectionChanged="GuiElementList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                        <local:NativeValidationPanel x:Name="GameValidationPanel"
                                                     Margin="10"
                                                     Visibility="Collapsed"
                                                     LaunchHairPatcherRequested="GameValidationPanel_LaunchHairPatcherRequested"
                                                     LogMessage="GameValidationPanel_LogMessage" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#343946"
                          ResizeDirection="Columns" />

            <Border x:Name="SceneSurface"
                    Grid.Column="2"
                    Background="#11141A"
                    Focusable="True"
                    MouseDown="Viewport_MouseDown"
                    MouseUp="Viewport_MouseUp"
                    LostMouseCapture="Viewport_LostMouseCapture"
                    MouseMove="Viewport_MouseMove"
                    MouseWheel="Viewport_MouseWheel">
                <Grid>
                    <glWpfControl:GLWpfControl x:Name="GpuViewport"
                                               IsHitTestVisible="False"
                                               Render="GpuViewport_OnRender" />
                    <Viewport3D x:Name="SceneViewport" ClipToBounds="True">
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="SceneCamera"
                                           FieldOfView="55"
                                           NearPlaneDistance="0.01"
                                           FarPlaneDistance="100000" />
                    </Viewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup x:Name="FloorGridRoot" />
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup x:Name="SceneRoot">
                                <AmbientLight Color="#70747D" />
                                <DirectionalLight Color="#FFFFFF" Direction="-0.45,-0.75,-0.6" />
                                <DirectionalLight Color="#59677F" Direction="0.55,0.25,0.7" />
                                <Model3DGroup x:Name="LoadedModelsRoot" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    </Viewport3D>

                    <!-- Separate overlay viewport: its independent depth buffer keeps
                         skeleton helpers visible through opaque/translucent geometry. -->
                    <Viewport3D x:Name="SkeletonViewport"
                                IsHitTestVisible="False"
                                ClipToBounds="True">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="SkeletonCamera"
                                               FieldOfView="55"
                                               NearPlaneDistance="0.01"
                                               FarPlaneDistance="100000" />
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#FFFFFF" />
                                    <Model3DGroup x:Name="SkeletonRoot" />
                                    <Model3DGroup x:Name="AttachmentRoot" />
                                    <Model3DGroup x:Name="CollisionRoot" />
                                    <Model3DGroup x:Name="ControlRigRoot" />
                                    <Model3DGroup x:Name="MarkerRoot" />
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- Floating panels were replaced by the left-column switcher.
                    <Border x:Name="SkeletonPanel"
                            Width="330"
                            MaxHeight="610"
                            Margin="12"
                            Padding="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#EE20242C"
                            BorderBrush="#4B5262"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="#F0F2F6" FontSize="16" FontWeight="SemiBold" Text="Слои просмотра"/>
                                <Button Grid.Column="1" Width="28" Height="25" Click="SkeletonPanelClose_Click" Content="×"/>
                            </Grid>
                            <StackPanel DockPanel.Dock="Top">
                                <CheckBox x:Name="ShowSkeletonCheck" Foreground="#D8DCE4" IsChecked="True" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Отобразить скелет"/>
                                <CheckBox x:Name="ShowAttachmentsCheck" Margin="0,6,0,0" Foreground="#D8DCE4" IsChecked="True" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Показать точки привязки"/>
                                <CheckBox x:Name="ShowCollisionCheck" Margin="0,6,0,0" Foreground="#D8DCE4" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Показать коллизии"/>
                                <CheckBox x:Name="ShowControlRigCheck" Margin="0,6,0,0" Foreground="#D8DCE4" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Показать control / IK rig"/>
                                <CheckBox x:Name="ShowMarkersCheck" Margin="0,6,0,0" Foreground="#D8DCE4" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Показать служебные маркеры"/>
                                <CheckBox x:Name="HighlightInfluencedMeshesCheck" Margin="0,6,0,9" Foreground="#D8DCE4" IsChecked="True" Checked="SkeletonOption_Changed" Unchecked="SkeletonOption_Changed" Content="Подсвечивать mesh выбранной кости"/>
                                <TextBlock Foreground="#9FA8B8" TextWrapping="Wrap" Text="Кость выбирается глобально; строки palette показывают локальные slots каждого spSkin."/>
                                <TextBox x:Name="BoneFilterBox" Margin="0,9,0,7" Padding="6,4" TextChanged="BoneFilter_Changed" ToolTip="Фильтр по имени кости или palette"/>
                            </StackPanel>
                            <Expander DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#D8DCE4" Header="Обнаруженные служебные объекты">
                                <ListBox x:Name="AuxiliaryObjectList" MaxHeight="125" Background="#171A20" BorderBrush="#343946" Foreground="#C9D0DC" DisplayMemberPath="Display" SelectionChanged="AuxiliaryObjectList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            </Expander>
                            <ListBox x:Name="BoneList"
                                     Background="#171A20"
                                     BorderBrush="#343946"
                                     Foreground="#E5E8EE"
                                     DisplayMemberPath="Display"
                                     SelectionChanged="BoneList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                    <Border x:Name="AnimationPanel" Width="390" MaxHeight="610" Margin="12" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EE20242C" BorderBrush="#4B5262" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="#F0F2F6" FontSize="16" FontWeight="SemiBold" Text="Анимации"/>
                                <Button Grid.Column="1" Width="28" Height="25" Click="AnimationPanelClose_Click" Content="×"/>
                            </Grid>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="AnimationSourceText" Foreground="#9FA8B8" TextWrapping="Wrap" Text="Анимации будут найдены рядом с открытой моделью."/>
                                <WrapPanel Margin="0,8,0,8">
                                    <Button Padding="8,4" Margin="0,0,6,0" Click="AddAnimationFiles_Click" Content="Добавить SAN/ANM…"/>
                                    <Button Padding="8,4" Click="ChooseAnimationFolder_Click" Content="Выбрать папку…"/>
                                </WrapPanel>
                                <TextBox x:Name="AnimationFilterBox" Margin="0,0,0,7" Padding="6,4" TextChanged="AnimationFilter_Changed" ToolTip="Фильтр по имени клипа или ANM-состоянию"/>
                            </StackPanel>
                            <ListBox x:Name="AnimationList" Background="#171A20" BorderBrush="#343946" Foreground="#E5E8EE" DisplayMemberPath="Display" SelectionChanged="AnimationList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>
                    -->
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#20242C"
                BorderBrush="#343946"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Grid x:Name="AnimationTimeline" DockPanel.Dock="Top" Margin="8,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Width="34" Height="27" Click="PreviousAnimationFrame_Click" Content="◀" ToolTip="Предыдущий кадр"/>
                    <Button x:Name="AnimationPlayPauseButton" Grid.Column="1" Width="42" Height="27" Margin="5,0" Click="AnimationPlayPause_Click" Content="▶" ToolTip="Воспроизведение / пауза"/>
                    <Button Grid.Column="2" Width="34" Height="27" Click="NextAnimationFrame_Click" Content="▶|" ToolTip="Следующий кадр"/>
                    <Slider x:Name="AnimationSlider" Grid.Column="3" Margin="10,0" VerticalAlignment="Center" Minimum="0" ValueChanged="AnimationSlider_ValueChanged"/>
                    <TextBlock x:Name="AnimationTimeText" Grid.Column="4" MinWidth="125" VerticalAlignment="Center" Foreground="#D8DCE4" TextAlignment="Right" Text="0 / 0"/>
                </Grid>
                <Grid DockPanel.Dock="Top" Background="#242832">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Margin="8,5"
                               Foreground="#D8DCE4"
                               Text="Откройте один или несколько SMO-файлов." />
                    <TextBlock x:Name="SceneStatsText"
                               Grid.Column="1"
                               Margin="12,5,8,5"
                               Foreground="#AEB5C2"
                               Text="Файлов: 0 · мешей: 0" />
                </Grid>
                <ListBox x:Name="StateLog"
                         Padding="4"
                         Background="#181B21"
                         BorderThickness="0"
                         Foreground="#BCC3CF"
                         FontFamily="Consolas"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
