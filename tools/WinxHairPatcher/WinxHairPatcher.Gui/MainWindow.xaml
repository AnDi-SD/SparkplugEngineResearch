<Window x:Class="WinxHairPatcher.Gui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Winx Club — Bloom Hair Patcher" Width="680" Height="760"
 MinWidth="560" MinHeight="620" WindowStartupLocation="CenterScreen">
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Bloom Hair Patcher" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Margin="0,6,0,14" Foreground="#52606D" TextWrapping="Wrap"
    Text="Выберите WinxClub.exe и отметьте костюмы, для которых игра должна загружать стандартную модель bloom_hair.smo."/>
   <Button Width="240" Height="38" HorizontalAlignment="Left" Content="Выбрать WinxClub.exe" Click="SelectExe_Click"/>
   <TextBlock x:Name="ExePathText" Margin="0,7,0,0" Text="Файл не выбран" TextWrapping="Wrap"/>
   <TextBlock x:Name="ExeStateText" Margin="0,5,0,0" Foreground="#52606D" Text="—" TextWrapping="Wrap"/>
  </StackPanel>

  <Border Grid.Row="1" Margin="0,16,0,10" Padding="10" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1">
   <TextBlock TextWrapping="Wrap" Text="Галочка означает: загружать и крепить внешние длинные волосы. Bloom X получает волосы обычным загрузчиком, но использует упрощённую логику без стандартной hair-физики. Только Winter является штатным исключением."/>
  </Border>

  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <ItemsControl x:Name="FashionList">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <CheckBox Margin="5" IsChecked="{Binding KeepHair}" IsEnabled="{Binding CanEnable}"
       ToolTip="{Binding Hint}">
       <StackPanel Orientation="Horizontal">
        <TextBlock Width="32" Text="{Binding Id, StringFormat=ID {0}}" Foreground="#52606D"/>
        <TextBlock Width="105" Text="{Binding Name}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Model}" Foreground="#52606D"/>
       </StackPanel>
      </CheckBox>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>

  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <Button x:Name="PatchButton" Height="44" Content="Применить патч" IsEnabled="False" Click="Patch_Click"/>
   <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="#52606D" TextWrapping="Wrap"
    Text="Выберите исполняемый файл игры. Перед заменой автоматически создаётся резервная копия."/>
  </StackPanel>
 </Grid>
</Window>
