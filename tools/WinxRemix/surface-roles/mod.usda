#usda 1.0
(
    defaultPrim = "RootNode"
    metersPerUnit = 1
    upAxis = "Y"
)

# Our classification metadata, not reconstructed geometry or game assets.
# Gardenia02 capture: grass is the opaque base of this two-pass ledge;
# rock is its alpha-blended overlay. The lower grass patch has no base.
# Author the category on both the hash prim and mesh child for runtime
# importer compatibility. Both have the same value; neither contains geometry.
def Xform "RootNode"
{
    def Scope "meshes"
    {
        def Xform "mesh_A572E833699D8C0C"
        {
            custom int preserveOriginalDrawCall = 1
            custom bool remix_category:decal_Static = 1
            over "mesh"
            {
                custom bool remix_category:decal_Static = 1
            }
        }
        def Xform "mesh_E75B321C979EE3E9"
        {
            custom int preserveOriginalDrawCall = 1
            custom bool remix_category:decal_Static = 0
            over "mesh"
            {
                custom bool remix_category:decal_Static = 0
            }
        }
    }
}
