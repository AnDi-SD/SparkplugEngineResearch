+// Local camera extension. Return the server's actual API result: enqueuing
+// alone does not establish that its Remix device accepted the camera.
+remixapi_ErrorCode REMIXAPI_CALL remixapi_SetupCamera(const remixapi_CameraInfo* info) {
+  ASSERT_REMIXAPI_PFN_TYPE(remixapi_SetupCamera);
+  if (!isSupportedCameraInfo(info)) return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+  if (!g_bInterfaceInitialized || !gbBridgeRunning) return REMIXAPI_ERROR_CODE_NOT_INITIALIZED;
+  serialize::CameraInfo serialized(*info);
+  if (serialized.size() != CameraInfoWireSize) return REMIXAPI_ERROR_CODE_INCOMPATIBLE_VERSION;
+  uint8_t payload[CameraInfoWireSize]{};
+  serialized.serialize(payload);
+  UID currentUID = 0;
+  {
+    ClientMessage command(Commands::RemixApi_SetupCamera);
+    currentUID = command.get_uid();
+    command.send_data(sizeof(payload), payload);
+  }
+  const auto transport = DeviceBridge::waitForCommand(Commands::Bridge_Response,
+    GlobalOptions::getAckTimeout(), nullptr, true, currentUID);
+  if (transport != Result::Success) {
+    // A delayed reply can remain at the head of the shared response queue.
+    // Returning to arbitrary D3D work is unsafe: merely disabling camera API
+    // does not make subsequent synchronous D3D waits consume that old UID.
+    Logger::err("[RemixApi_SetupCamera] Fatal transport failure; UID=" + std::to_string(currentUID) +
+      " result=" + std::to_string(static_cast<unsigned>(transport)) + "; terminating client, no recovery.");
+    gbBridgeRunning = false;
+    TerminateProcess(GetCurrentProcess(), 0xE052CA01u);
+    std::abort(); // Never continue if the terminal OS call unexpectedly fails.
+  }
+  const auto result = static_cast<remixapi_ErrorCode>(DeviceBridge::get_data());
+  DeviceBridge::pop_front();
+  return result;
+}
