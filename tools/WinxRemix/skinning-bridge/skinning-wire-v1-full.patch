 #include <type_traits>
 #include <typeinfo>
 #include <assert.h>
+#include <cmath>
+#include <stdexcept>
 
 using namespace remixapi::util::serialize;
 
 namespace remixapi {
 namespace util {
+namespace {
+// Wire sizes are architecture independent; HardcodedVertex padding is omitted.
+static_assert(sizeof(float) == 4 && sizeof(remixapi_Bool) == 4);
+constexpr uint32_t kMeshVertexWireBytes = 9 * sizeof(uint32_t);
+constexpr uint32_t kTransformWireBytes = 12 * sizeof(float);
+bool addWireArray(uint64_t& size, uint64_t count, uint32_t stride) {
+  if (count > (UINT32_MAX - size) / stride) return false;
+  size += count * stride;
+  return true;
+}
+struct PayloadCursor {
+  const uint8_t* data;
+  uint64_t left;
+  bool skip(uint64_t count, uint32_t stride) {
+    if (count > left / stride) return false;
+    const size_t bytes = static_cast<size_t>(count * stride);
+    data += bytes;
+    left -= bytes;
+    return true;
+  }
+  template<typename T> bool read(T& output) {
+    if (left < sizeof(T)) return false;
+    memcpy(&output, data, sizeof(T));
+    return skip(1, sizeof(T));
+  }
+};
+bool payloadHeader(PayloadCursor& c, uint32_t size, remixapi_StructType expected) {
+  uint32_t bytes = 0, type = 0;
+  return c.read(bytes) && bytes == size && c.read(type) && type == expected;
+}
+}
+
+bool isSupportedMeshInfo(const remixapi_MeshInfo* info, uint32_t* wireSize) {
+  if (!info || info->sType != REMIXAPI_STRUCT_TYPE_MESH_INFO || info->pNext ||
+      (info->surfaces_count && !info->surfaces_values)) return false;
+  uint64_t bytes = 4 + 4 + 8 + 4;
+  if (!addWireArray(bytes, info->surfaces_count, 8 + 8 + 4 + 4)) return false;
+  for (uint32_t i = 0; i < info->surfaces_count; ++i) {
+    const auto& s = info->surfaces_values[i];
+    if ((s.vertices_count && !s.vertices_values) || (s.indices_count && !s.indices_values) ||
+        !addWireArray(bytes, s.vertices_count, kMeshVertexWireBytes) ||
+        !addWireArray(bytes, s.indices_count, sizeof(uint32_t))) return false;
+    if (s.skinning_hasvalue) {
+      const auto& skin = s.skinning_value;
+      if (!skin.bonesPerVertex || s.vertices_count > UINT32_MAX / skin.bonesPerVertex) return false;
+      const uint64_t elements = s.vertices_count * skin.bonesPerVertex;
+      if (skin.blendWeights_count != elements || skin.blendIndices_count != elements ||
+          (elements && (!skin.blendWeights_values || !skin.blendIndices_values)) ||
+          !addWireArray(bytes, 3, sizeof(uint32_t)) ||
+          !addWireArray(bytes, elements, sizeof(float) + sizeof(uint32_t))) return false;
+    }
+  }
+  if (wireSize) *wireSize = static_cast<uint32_t>(bytes);
+  return true;
+}
+
+bool validateMeshInfoPayload(const void* data, uint32_t size) {
+  if (!data) return false;
+  PayloadCursor c{static_cast<const uint8_t*>(data), size};
+  uint32_t surfaces = 0;
+  if (!payloadHeader(c, size, REMIXAPI_STRUCT_TYPE_MESH_INFO) ||
+      !c.skip(1, sizeof(uint64_t)) || !c.read(surfaces) || surfaces > c.left / 24) return false;
+  for (uint32_t i = 0; i < surfaces; ++i) {
+    uint64_t vertices = 0, indices = 0;
