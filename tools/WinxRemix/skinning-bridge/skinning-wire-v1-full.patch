+// Local contract tests for the production CameraInfo serializer and validator.
+// Runs without a device or bridge process; cross-architecture files use the
+// exact payload consumed by RemixApi_SetupCamera, not a test-only encoder.
+#include "util_remixapi.h"
+#include <array>
+#include <fstream>
+#include <iostream>
+#include <limits>
+
+using namespace remixapi::util;
+static unsigned checks;
+static bool check(bool value, const char* name) {
+  ++checks;
+  if (!value) std::cerr << "FAIL " << name << '\n';
+  return value;
+}
+
+static remixapi_CameraInfo fixture(unsigned index) {
+  remixapi_CameraInfo camera{};
+  camera.sType = REMIXAPI_STRUCT_TYPE_CAMERA_INFO;
+  camera.type = static_cast<remixapi_CameraType>(index);
+  for (unsigned row = 0; row < 4; ++row) {
+    for (unsigned col = 0; col < 4; ++col) {
+      camera.view[row][col] = float(index * 64 + row * 4 + col) * -0.125f;
+      camera.projection[row][col] = float(index * 64 + row * 4 + col + 3) * 0.0625f;
+    }
+  }
+  const uint32_t minusZero = 0x80000000, subnormal = 1;
+  memcpy(&camera.view[0][0], &minusZero, 4);
+  memcpy(&camera.projection[3][3], &subnormal, 4);
+  return camera;
+}
+
+using Payload = std::array<uint8_t, CameraInfoWireSize>;
+static Payload encode(const remixapi_CameraInfo& camera) {
+  serialize::CameraInfo serializable(camera);
+  Payload bytes{};
+  serializable.serialize(bytes.data());
+  return bytes;
+}
+static bool same(const remixapi_CameraInfo& a, const remixapi_CameraInfo& b) {
+  return a.sType == b.sType && a.type == b.type && !a.pNext && !b.pNext &&
+    !memcmp(a.view, b.view, sizeof(a.view)) && !memcmp(a.projection, b.projection, sizeof(a.projection));
+}
+
+static bool localChecks() {
+  bool passed = true;
+  for (unsigned index = 0; index < 3; ++index) {
+    const auto expected = fixture(index);
+    serialize::CameraInfo serializable(expected);
+    passed &= check(serializable.size() == CameraInfoWireSize && serializable.calcSize() == CameraInfoWireSize, "fixed wire size");
+    std::array<uint8_t, CameraInfoWireSize + 32> guarded;
+    guarded.fill(0xcd);
+    serializable.serialize(guarded.data() + 16);
+    for (unsigned i = 0; i < 16; ++i) passed &= check(guarded[i] == 0xcd && guarded[16 + CameraInfoWireSize + i] == 0xcd, "encode guard");
+    remixapi_CameraInfo decoded{};
+    passed &= check(decodeCameraInfoPayload(guarded.data() + 16, CameraInfoWireSize, decoded) && same(decoded, expected), "round trip exact matrix bits");
+    std::array<uint8_t, CameraInfoWireSize + 1> unaligned;
+    memcpy(unaligned.data() + 1, guarded.data() + 16, CameraInfoWireSize);
+    passed &= check(decodeCameraInfoPayload(unaligned.data() + 1, CameraInfoWireSize, decoded) && same(decoded, expected), "unaligned wire input");
+  }
+  const auto expected = fixture(0);
+  const auto payload = encode(expected);
+  remixapi_CameraInfo output = fixture(2);
+  const auto unchanged = output;
+  for (uint32_t size = 0; size < CameraInfoWireSize; ++size) {
+    passed &= check(!decodeCameraInfoPayload(payload.data(), size, output) && same(output, unchanged), "truncated input rejected without mutation");
+  }
+  passed &= check(!decodeCameraInfoPayload(nullptr, CameraInfoWireSize, output), "null wire input");
+  passed &= check(!decodeCameraInfoPayload(payload.data(), CameraInfoWireSize + 1, output), "oversized wire envelope");
+  for (unsigned word : {0u, 1u, 2u}) {
+    auto corrupt = payload;
+    const uint32_t invalid = 0xffffffff;
+    memcpy(corrupt.data() + word * 4, &invalid, 4);
+    passed &= check(!decodeCameraInfoPayload(corrupt.data(), CameraInfoWireSize, output) && same(output, unchanged), "invalid size sType or camera type");
+    passed &= check(decodeCameraInfoPayload(payload.data(), CameraInfoWireSize, output) && same(output, expected), "valid next item after rejection");
+    output = unchanged;
+  }
+  passed &= check(!isSupportedCameraInfo(nullptr), "null camera input");
+  auto invalid = expected;
+  invalid.pNext = reinterpret_cast<void*>(static_cast<uintptr_t>(0x12345678));
+  passed &= check(!isSupportedCameraInfo(&invalid), "unsupported pNext rejected before send");
+  // The actual serializer never sends a process-local pNext, even if used alone.
+  passed &= check(encode(invalid) == payload, "pNext is omitted from wire");
+  for (uint32_t bad : {0x7fc00001u, 0x7f800000u, 0xff800000u}) {
+    invalid = expected;
+    memcpy(&invalid.view[2][1], &bad, 4);
+    passed &= check(!isSupportedCameraInfo(&invalid), "nonfinite client matrix rejected");
+    const auto bytes = encode(invalid);
+    passed &= check(!decodeCameraInfoPayload(bytes.data(), bytes.size(), output), "nonfinite server matrix rejected");
+  }
+  return passed;
+}
+
+int main(int argc, char** argv) {
+  if (argc != 3 || (strcmp(argv[1], "--write") && strcmp(argv[1], "--read"))) return 2;
+  if (!localChecks()) return 1;
+  constexpr uint32_t magic = 0x314d4143, tail = 0xdeadbeef;
+  if (!strcmp(argv[1], "--write")) {
+    std::ofstream stream(argv[2], std::ios::binary);
+    stream.write(reinterpret_cast<const char*>(&magic), sizeof(magic));
+    for (unsigned index = 0; index < 3; ++index) {
+      const auto payload = encode(fixture(index));
+      stream.write(reinterpret_cast<const char*>(payload.data()), payload.size());
+    }
+    stream.write(reinterpret_cast<const char*>(&tail), sizeof(tail));
+    if (!stream) return 1;
+  } else {
+    std::ifstream stream(argv[2], std::ios::binary);
+    uint32_t got = 0;
+    stream.read(reinterpret_cast<char*>(&got), sizeof(got));
+    if (!check(got == magic, "file envelope")) return 1;
+    for (unsigned index = 0; index < 3; ++index) {
+      Payload payload{};
+      stream.read(reinterpret_cast<char*>(payload.data()), payload.size());
+      remixapi_CameraInfo decoded{};
+      if (!check(bool(stream) && decodeCameraInfoPayload(payload.data(), payload.size(), decoded) && same(decoded, fixture(index)), "cross architecture exact camera")) return 1;
+    }
+    stream.read(reinterpret_cast<char*>(&got), sizeof(got));
+    if (!check(bool(stream) && got == tail && stream.peek() == EOF, "following item boundary and exact file end")) return 1;
+  }
+  std::cout << "PASS " << checks << " camera checks, pointerBytes=" << sizeof(void*) << " wireBytes=" << CameraInfoWireSize << '\n';
+  return 0;
+}
