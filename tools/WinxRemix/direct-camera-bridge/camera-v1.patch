 #include <type_traits>
 #include <typeinfo>
 #include <assert.h>
+#include <cmath>
 
 using namespace remixapi::util::serialize;
 
 namespace remixapi {
 namespace util {
+bool isSupportedCameraInfo(const remixapi_CameraInfo* info) {
+  if (!info || info->sType != REMIXAPI_STRUCT_TYPE_CAMERA_INFO || info->pNext ||
+      (info->type != REMIXAPI_CAMERA_TYPE_WORLD && info->type != REMIXAPI_CAMERA_TYPE_SKY &&
+       info->type != REMIXAPI_CAMERA_TYPE_VIEW_MODEL)) return false;
+  for (unsigned row = 0; row < 4; ++row) {
+    for (unsigned col = 0; col < 4; ++col) {
+      if (!std::isfinite(info->view[row][col]) || !std::isfinite(info->projection[row][col])) return false;
+    }
+  }
+  return true;
+}
+
+bool decodeCameraInfoPayload(const void* data, uint32_t size, remixapi_CameraInfo& output) {
+  // Check the entire envelope before the existing unbounded POD serializer.
+  if (!data || size != CameraInfoWireSize) return false;
+  uint32_t declaredSize = 0;
+  memcpy(&declaredSize, data, sizeof(declaredSize));
+  if (declaredSize != CameraInfoWireSize) return false;
+  serialize::CameraInfo decoded(const_cast<void*>(data));
+  decoded.deserialize();
+  if (!isSupportedCameraInfo(&decoded)) return false;
+  output = decoded;
+  return true;
+}
