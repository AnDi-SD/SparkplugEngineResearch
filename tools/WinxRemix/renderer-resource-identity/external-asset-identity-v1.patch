+// Own external asset identity contract for the pinned WinxRemix renderer patch.
+// API callers opt in before creating meshes and supply immutable content IDs.
+// These IDs do not replace geometry component, cache, or instance identities.
+#pragma once
+
+#include <cstdint>
+
+namespace dxvk {
+
+struct ExternalAssetIdentity {
+  uint64_t meshHash = 0;
+  uint64_t materialHash = 0;
+
+  static constexpr ExternalAssetIdentity ForMesh(const bool enabled,
+      const uint32_t surfaceCount, const bool hasSkinning,
+      const uint64_t meshHash, const uint64_t materialHash) {
+    // V1 admits one rigid surface with an immutable material binding only.
+    if (!enabled || surfaceCount != 1 || hasSkinning || meshHash == 0 || materialHash == 0) {
+      return {};
+    }
+    return { meshHash, materialHash };
+  }
+
+  constexpr ExternalAssetIdentity ForDraw(const bool opaque,
+      const bool hasSkinning, const bool particles, const bool gpuInstancing) const {
+    if (!opaque || hasSkinning || particles || gpuInstancing || meshHash == 0 || materialHash == 0) {
+      return {};
+    }
+    return *this;
+  }
+
+  constexpr uint64_t meshHashOr(const uint64_t fallback) const {
+    return meshHash != 0 && materialHash != 0 ? meshHash : fallback;
+  }
+
+  constexpr uint64_t materialHashOr(const uint64_t fallback) const {
+    return meshHash != 0 && materialHash != 0 ? materialHash : fallback;
+  }
+};
+
