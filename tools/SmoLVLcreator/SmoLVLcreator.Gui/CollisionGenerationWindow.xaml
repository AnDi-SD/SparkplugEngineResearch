<Window x:Class="SmoLVLcreator.Gui.CollisionGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание коллизии"
        Width="900" Height="620" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#11171E" Foreground="#E3E8EE">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Коллизия по выделенной геометрии"/>
            <TextBlock Margin="0,3,0,0" Foreground="#8593A3"
                       Text="Синяя модель — источник, оранжевая оболочка — результат. ПКМ — вращение, колесо — масштаб."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,12,0" Background="#0C1219"
                BorderBrush="#303C49" BorderThickness="1" CornerRadius="5"
                ClipToBounds="True">
            <Viewport3D x:Name="PreviewViewport"
                        MouseDown="PreviewViewport_MouseDown"
                        MouseUp="PreviewViewport_MouseUp"
                        MouseMove="PreviewViewport_MouseMove"
                        MouseWheel="PreviewViewport_MouseWheel">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="PreviewCamera" FieldOfView="48"
                                       NearPlaneDistance="0.01" FarPlaneDistance="100000"/>
                </Viewport3D.Camera>
                <ModelVisual3D x:Name="PreviewVisual"/>
            </Viewport3D>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Padding="15" Background="#18212B"
                BorderBrush="#303C49" BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#B8C5D3"
                           Text="ПАРАМЕТРЫ"/>
                <TextBlock Margin="0,16,0,5" Foreground="#AAB5C2"
                           Text="Лимит треугольников"/>
                <TextBox x:Name="TriangleBudgetBox" Padding="7,5" Text="64"
                         KeyDown="ParameterBox_KeyDown"/>
                <TextBlock Margin="0,5,0,0" Foreground="#718092" FontSize="11"
                           TextWrapping="Wrap"
                           Text="Жёсткий верхний предел. Допустимо от 12 до 256."/>

                <TextBlock Margin="0,16,0,5" Foreground="#AAB5C2"
                           Text="Отступ оболочки"/>
                <TextBox x:Name="PaddingBox" Padding="7,5" Text="0.05"
                         KeyDown="ParameterBox_KeyDown"/>
                <TextBlock Margin="0,5,0,0" Foreground="#718092" FontSize="11"
                           TextWrapping="Wrap"
                           Text="Расстояние от исходной геометрии в единицах уровня."/>

                <Button Margin="0,18,0,0" Padding="10,6"
                        Click="RefreshPreview_Click" Content="Обновить предпросмотр"/>
                <Separator Margin="0,18,0,14" Background="#33404D"/>
                <TextBlock x:Name="ResultStatsText" Foreground="#79C38B"
                           TextWrapping="Wrap" Text="—"/>
                <TextBlock x:Name="ValidationText" Margin="0,9,0,0"
                           Foreground="#E69A46" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="2,13,0,0" VerticalAlignment="Center"
                   Foreground="#778697" Text="Результат не записывается в документ до подтверждения."/>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="85" Margin="0,0,8,0" Padding="12,6"
                    IsCancel="True" Content="Отмена"/>
            <Button x:Name="ConfirmButton" MinWidth="110" Padding="12,6"
                    IsDefault="True" Click="Confirm_Click" Content="Создать"/>
        </StackPanel>
    </Grid>
</Window>
