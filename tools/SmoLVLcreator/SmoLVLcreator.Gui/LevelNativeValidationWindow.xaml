<Window x:Class="SmoLVLcreator.Gui.LevelNativeValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmoLVLcreator — проверка уровня в игре"
        Width="780" Height="700" MinWidth="650" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#D8DEE9"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#E4E9EF"/>
            <Setter Property="Background" Value="#202833"/>
            <Setter Property="BorderBrush" Value="#3A4858"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Foreground" Value="#D8DEE9"/>
            <Setter Property="Background" Value="#10161D"/>
            <Setter Property="BorderBrush" Value="#303B49"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="#F2F5F8"
                       Text="Проверка текущего уровня в WinxClub.exe"/>
            <TextBlock Margin="0,5,0,12" Foreground="#8F9BAA" TextWrapping="Wrap"
                       Text="Редактор сначала собирает несохранённые изменения во временный SMO. Исходный уровень и файлы установленной игры не изменяются."/>
        </StackPanel>

        <Border Grid.Row="1" Padding="11" Background="#171E27" BorderBrush="#2B3542" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#8F9BAA" Text="WinxClub.exe"/>
                    <TextBox x:Name="GamePathBox" Margin="0,4,8,0" IsReadOnly="True" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="FindGameButton" Grid.Column="1" Margin="0,19,6,0" Click="FindGame_Click" Content="Найти"/>
                <Button x:Name="ChooseGameButton" Grid.Column="2" Margin="0,19,0,0" Click="ChooseGame_Click" Content="Выбрать…"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,11,0,0" Padding="11"
                Background="#171E27" BorderBrush="#2B3542" BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <TextBlock Foreground="#F2F5F8" FontWeight="SemiBold"
                           Text="Проверка через настоящий игровой переход"/>
                <TextBlock Margin="0,4,0,0" Foreground="#AEB8C8" TextWrapping="Wrap"
                           Text="После запуска загрузите сохранение или войдите в нужную комнату. Тестер дождётся запроса исходного SMO, подставит временную сборку редактора и проверит её загрузку. Принудительный startLevel и подмена служебных ресурсов не используются."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Foreground="#8F9BAA" Text="Исходный путь уровня внутри Media"/>
            <TextBox x:Name="LogicalPathBox" Margin="0,4,0,0" TextWrapping="Wrap" TextChanged="LogicalPathBox_TextChanged"/>
            <TextBlock x:Name="RouteHintText" Margin="0,5,0,0" Foreground="#8290A0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="ResultTitleText" FontSize="17" FontWeight="Bold" Foreground="#D8DEE9" Text="Ожидание запуска"/>
                <TextBlock x:Name="ProgressText" HorizontalAlignment="Right" Foreground="#8F9BAA" Text="0%"/>
            </DockPanel>
            <ProgressBar x:Name="ValidationProgress" Height="8" Margin="0,7,0,0" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ResultDetailText" Margin="0,7,0,0" Foreground="#AEB8C8" TextWrapping="Wrap"
                       Text="Выберите игру и нажмите «Проверить»."/>
        </StackPanel>

        <ListBox x:Name="EventsList" Grid.Row="5" Margin="0,12,0,0"
                 Background="#11171E" BorderBrush="#2B3542" Foreground="#CAD2DC"
                 FontFamily="Consolas" FontSize="11"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <DockPanel Grid.Row="6" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="StartButton" Margin="0,0,7,0" IsEnabled="False" Click="Start_Click" Content="Запустить проверку"/>
                <Button x:Name="StopButton" Margin="0,0,7,0" IsEnabled="False" Click="Stop_Click" Content="Остановить"/>
                <Button x:Name="OpenLogButton" IsEnabled="False" Click="OpenLog_Click" Content="Открыть лог"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" Click="Close_Click" Content="Закрыть"/>
        </DockPanel>
    </Grid>
</Window>
