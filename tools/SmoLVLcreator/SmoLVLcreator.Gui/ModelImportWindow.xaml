<Window x:Class="SmoLVLcreator.Gui.ModelImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Dialog.Import.Title}"
        Width="720" Height="510" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#11171E" Foreground="#E3E8EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ModelNameText" FontSize="18" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

        <Grid x:Name="TextureEditPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="MaterialLibraryPanel" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Loc.Dialog.Import.MaterialLibrary}" FontWeight="SemiBold"/>
                <DockPanel Margin="0,5,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Padding="9,4" Margin="8,0,0,0" Click="ChooseMtl_Click"
                                Content="{DynamicResource Loc.Dialog.Import.ChooseMtl}"
                                ToolTip="{DynamicResource Loc.Dialog.Import.MtlResetHint}"/>
                        <Button x:Name="ResetMtlButton" Padding="9,4" Margin="8,0,0,0" Click="ResetMtl_Click"
                                Content="{DynamicResource Loc.Dialog.Import.ResetMtl}"
                                ToolTip="{DynamicResource Loc.Dialog.Import.MtlResetHint}"/>
                    </StackPanel>
                    <TextBlock x:Name="MaterialLibraryText" Foreground="#AAB5C2"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AutoAssignButton" Padding="9,4" Click="AutoAssign_Click"
                            Content="{DynamicResource Loc.Dialog.Import.AutoAssign}"
                            ToolTip="{DynamicResource Loc.Dialog.Import.AutoHint}"/>
                    <Button x:Name="ResetAutoButton" Padding="9,4" Margin="8,0,0,0" Click="ResetAuto_Click"
                            Content="{DynamicResource Loc.Dialog.Import.ResetAuto}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Loc.Dialog.Import.TextureSlots}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Grid.Row="2" Background="#18212B" BorderBrush="#303C49" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <TextBlock x:Name="EmptyTexturesText" Text="{DynamicResource Loc.Dialog.Import.NoSlots}"
                               Foreground="#AAB5C2" Margin="8" TextWrapping="Wrap"/>
                    <ListBox x:Name="SlotList" Background="Transparent" Foreground="#E3E8EE" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#303C49">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Materials}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Materials}" Foreground="#AAB5C2" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Text="{Binding Image}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ImagePath}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Padding="9,4" Click="AssignImage_Click"
                                                        Content="{DynamicResource Loc.Dialog.Import.ChooseImage}"/>
                                                <Button Padding="9,4" Margin="6,0,0,0"
                                                        IsEnabled="{Binding IsManual}" Click="ClearImage_Click"
                                                        Content="{DynamicResource Loc.Dialog.Import.ClearImage}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <TextBlock x:Name="UnusedImagesText" Grid.Row="3" Margin="0,7,0,0" Foreground="#E6A35B"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Padding="14,6" Margin="8,0,8,0" IsCancel="True"
                        Click="Cancel_Click"
                        Content="{DynamicResource Loc.Dialog.Cancel}"/>
                <Button x:Name="ContinueButton" Padding="14,6" IsDefault="True" Click="Continue_Click"
                        Content="{DynamicResource Loc.Dialog.Import.Continue}"/>
            </StackPanel>
            <TextBlock x:Name="EditStatusText" VerticalAlignment="Center" Foreground="#AAB5C2" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
