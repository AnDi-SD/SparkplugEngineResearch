<Window x:Class="SmoLVLcreator.Gui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки SmoLVLcreator"
        Width="590"
        Height="330"
        MinWidth="520"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#11171E"
        Foreground="#E3E8EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Настройки"/>
            <TextBlock Margin="0,4,0,18" Foreground="#8793A2" Text="Профиль быстрого экспорта выбранных объектов"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="16" Background="#18212B" BorderBrush="#303C49" BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <TextBlock Margin="0,0,0,5" Foreground="#AAB5C2" Text="Папка быстрого экспорта"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExportDirectoryBox"
                             MinHeight="30"
                             Padding="7,5"
                             Foreground="#E3E8EE"
                             Background="#0F151C"
                             BorderBrush="#344252"/>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="14,5"
                            Click="BrowseExportDirectory_Click"
                            Content="Обзор…"/>
                </Grid>

                <TextBlock Margin="0,16,0,5" Foreground="#AAB5C2" Text="Формат быстрого экспорта"/>
                <ComboBox x:Name="ExportFormatBox" Width="190" HorizontalAlignment="Left" SelectedIndex="0">
                    <ComboBoxItem Tag="Glb" Content="GLB · glTF Binary"/>
                    <ComboBoxItem Tag="Fbx" Content="FBX · Autodesk FBX"/>
                    <ComboBoxItem Tag="Obj" Content="OBJ · Wavefront"/>
                </ComboBox>
                <TextBlock Margin="0,13,0,0"
                           Foreground="#748293"
                           TextWrapping="Wrap"
                           Text="Команда «Экспорт» использует этот профиль без диалога. «Экспортировать как…» всегда открывает стандартное окно Windows и позволяет выбрать формат заново. Для FBX требуется SmoFbxBridge.exe."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="90" Margin="0,0,8,0" Padding="14,6" IsCancel="True" Content="Отмена"/>
            <Button MinWidth="105" Padding="14,6" IsDefault="True" Click="Save_Click" Content="Сохранить"/>
        </StackPanel>
    </Grid>
</Window>
