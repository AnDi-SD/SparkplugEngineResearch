<Window x:Class="SmoExporter.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sparkplug SMO Exporter"
        Width="620"
        Height="370"
        MinWidth="520"
        MinHeight="280"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SMO Exporter"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#17202A" />

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="12"
                Background="White"
                BorderBrush="#D5DAE0"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Модель:"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ModelPathText"
                           Grid.Column="1"
                           Text="Файл не выбран"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Папка сохранения:"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <TextBox x:Name="OutputPathTextBox"
                     Grid.Column="1"
                     Height="32"
                     Padding="8,4"
                     IsReadOnly="True"
                     Text="Не выбрана"
                     VerticalContentAlignment="Center" />
            <Button x:Name="BrowseOutputButton"
                    Grid.Column="2"
                    Width="82"
                    Height="32"
                    Margin="8,0,0,0"
                    Content="Обзор…"
                    Click="BrowseOutput_Click" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Формат экспорта:"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="FormatComboBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      Padding="8,5">
                <ComboBoxItem Content="GLB — один файл" Tag="glb" />
                <ComboBoxItem Content="OBJ + MTL + PNG" Tag="obj" />
                <ComboBoxItem Content="GLB и OBJ" Tag="both" />
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="4"
                    Margin="0,24,0,18"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button x:Name="SelectButton"
                    Width="160"
                    Height="42"
                    Margin="0,0,10,0"
                    Content="Выбрать модель"
                    Click="SelectModel_Click" />
            <Button x:Name="ExportButton"
                    Width="160"
                    Height="42"
                    Margin="0,0,10,0"
                    Content="Экспортировать"
                    IsEnabled="False"
                    Click="Export_Click" />
            <Button x:Name="ResetButton"
                    Width="110"
                    Height="42"
                    Content="Сброс"
                    IsEnabled="False"
                    Click="Reset_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="5"
                   Text="Выберите исходный SMO-файл."
                   Foreground="#52606D"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
