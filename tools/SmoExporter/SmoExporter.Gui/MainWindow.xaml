<Window x:Class="SmoExporter.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sparkplug SMO Exporter"
        Width="720"
        Height="800"
        MinWidth="520"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SMO Exporter"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#17202A" />

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="12"
                Background="White"
                BorderBrush="#D5DAE0"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Модель:"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ModelPathText"
                           Grid.Column="1"
                           Text="Файл не выбран"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Папка сохранения:"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <TextBox x:Name="OutputPathTextBox"
                     Grid.Column="1"
                     Height="32"
                     Padding="8,4"
                     IsReadOnly="True"
                     Text="Не выбрана"
                     VerticalContentAlignment="Center" />
            <Button x:Name="BrowseOutputButton"
                    Grid.Column="2"
                    Width="82"
                    Height="32"
                    Margin="8,0,0,0"
                    Content="Обзор…"
                    Click="BrowseOutput_Click" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Формат экспорта:"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="FormatComboBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      Padding="8,5"
                      SelectionChanged="FormatComboBox_SelectionChanged">
                <ComboBoxItem Content="GLB — один файл" Tag="glb" />
                <ComboBoxItem x:Name="FbxFormatItem" Content="FBX — skeleton + animations" Tag="fbx" />
                <ComboBoxItem Content="OBJ + MTL + PNG" Tag="obj" />
                <ComboBoxItem x:Name="AllFormatsItem" Content="Все форматы" Tag="all" />
            </ComboBox>
        </Grid>

        <Border Grid.Row="4" Margin="0,14,0,0" Padding="10" Background="White" BorderBrush="#D5DAE0" BorderThickness="1" CornerRadius="5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="9,4" Click="CheckBlender_Click" Content="Проверить снова"/>
                <Ellipse x:Name="BlenderStatusDot" Width="11" Height="11" Margin="0,0,8,0" Fill="#C0392B"/>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Blender необходим для экспорта FBX"/>
                    <TextBlock x:Name="BlenderStatusText" Margin="0,3,0,0" Foreground="#8A2D24" Text="Проверка наличия Blender…" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="5" Margin="0,12,0,0" Padding="10" Background="White" BorderBrush="#D5DAE0" BorderThickness="1" CornerRadius="5">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Анимации SAN для GLB/FBX"/>
                    <WrapPanel Grid.Column="1">
                        <Button Padding="7,3" Margin="0,0,5,0" Click="AddAnimationFiles_Click" Content="Добавить…"/>
                        <Button Padding="7,3" Margin="0,0,5,0" Click="AddAnimationFolder_Click" Content="Папка…"/>
                        <Button Padding="7,3" Margin="0,0,5,0" Click="SelectAllAnimations_Click" Content="Все"/>
                        <Button Padding="7,3" Click="ClearAnimations_Click" Content="Ничего"/>
                    </WrapPanel>
                </Grid>
                <ListBox x:Name="AnimationList" MinHeight="130" MaxHeight="210" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}" Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="6"
                    Margin="0,16,0,12"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button x:Name="SelectButton"
                    Width="160"
                    Height="42"
                    Margin="0,0,10,0"
                    Content="Выбрать модель"
                    Click="SelectModel_Click" />
            <Button x:Name="ExportButton"
                    Width="160"
                    Height="42"
                    Margin="0,0,10,0"
                    Content="Экспортировать"
                    IsEnabled="False"
                    Click="Export_Click" />
            <Button x:Name="ResetButton"
                    Width="110"
                    Height="42"
                    Content="Сброс"
                    IsEnabled="False"
                    Click="Reset_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="7"
                   Text="Выберите исходный SMO-файл."
                   Foreground="#52606D"
                   TextWrapping="Wrap" />

        <Border Grid.Row="8" Margin="0,10,0,0" Background="#171A20" BorderBrush="#343946" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Padding="9,6" Background="#242832" Foreground="#E5E8EE" FontWeight="SemiBold" Text="Журнал экспорта"/>
                <ListBox x:Name="ExportLog" Padding="5" Background="#171A20" BorderThickness="0" Foreground="#C9D0DC" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
