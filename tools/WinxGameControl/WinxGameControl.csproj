<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <ViGEmClientAssembly Condition="'$(ViGEmClientAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\local-data\test-output\winxcoop-e5-r1\gamepad-helper-v10\Nefarius.ViGEm.Client.dll</ViGEmClientAssembly>
  </PropertyGroup>
  <ItemGroup>
    <!-- Existing offline SDK assembly, version1.21.256.0; no driver installer. -->
    <Reference Include="Nefarius.ViGEm.Client">
      <HintPath>$(ViGEmClientAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
