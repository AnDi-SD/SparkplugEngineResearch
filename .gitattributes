# Research provenance uses SHA-256 of exact file bytes, including line endings.
# Preserve evidence, manifests and cited source/dossiers on every platform.
/research/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/Sparkplug/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/Winx/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/docs/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/journal/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# SAN/VMD validation manifests also record exact Python source hashes.
/tools/SanToVmd/*.py -text whitespace=trailing-space,space-before-tab,cr-at-eol
/tools/SanToVmd/tests/*.py -text whitespace=trailing-space,space-before-tab,cr-at-eol
# The native viewing bridge is also pinned by exact source hashes.
/tools/SparkplugViewer.Native/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Remix adapter snapshots and patches retain their exact source bytes after relocation.
/tools/WinxRemix/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
