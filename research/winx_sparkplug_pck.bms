# Winx Club / Sparkplug Engine .PCK extractor
# Validated structurally against BLOOM.PCK and ST1.PCK (PS2).
# Data is stored raw; byte offsets are also stored as 0x800-byte sectors.

endian little

get STRTAB_SIZE long
savepos STRTAB_OFF

math INDEX_OFF = STRTAB_OFF
math INDEX_OFF += STRTAB_SIZE
goto INDEX_OFF

get FILES long
get RESERVED long

set PATH_OFF long 0

for i = 0 < FILES
    get NAME_OFF long
    get SECTOR_OFF long
    get OFFSET long
    get SIZE long
    get NEXT_PATH_OFF long
    savepos INDEX_POS

    math TMP = STRTAB_OFF
    math TMP += PATH_OFF
    goto TMP
    get PATH string

    math TMP = STRTAB_OFF
    math TMP += NAME_OFF
    goto TMP
    get NAME string

    set FULLNAME string PATH
    string FULLNAME += "/"
    string FULLNAME += NAME

    log FULLNAME OFFSET SIZE

    set PATH_OFF long NEXT_PATH_OFF
    goto INDEX_POS
next i
