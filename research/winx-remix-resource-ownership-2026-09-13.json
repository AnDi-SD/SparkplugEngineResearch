  "contract": {
    "ownership": [
      "Preallocate pending material/mesh cache node before API Create; mesh sequential indices allocate before Create too.",
      "Pending handle is null and usable=false. Any observed nonnull Create output is assigned to that owner even on failure or std::bad_alloc.",
      "Return handle only after SUCCESS, same retirement serial and same frame. Failed/invalid output gets immediate Destroy; failed Destroy retains unusable quarantine, bytes and material dependency for retry.",
      "Cache emplace/index allocation failure returns null before API Create. Repeated usable keys reuse one owner; pending/quarantine keys reject.",
      "surface*Creates count observed nonnull handles, including failed API outputs; successful-destruction counters exclude failed Destroy attempts."
    ],
    "reentry": [
      "Existing recursive guard serializes own cache operations. Nested resource creation/pressure rejects while one operation is busy.",
      "No cache iterator/reference crosses COM/API calls; deletion copies descriptor then refinds by key and handle.",
      "Retirement invalidates serial/ownership epoch even for empty caches. Busy operation records pending retirement; bounded outer drain releases mesh dependencies before materials.",
      "A repeatedly failing, reentrant retirement can remain pending. Next creation drains once and rejects if still pending; no cached handle escapes pending retirement."
    ],
    "pressure": {
      "meshLimit": 512,
      "materialLimit": 256,
      "meshByteLimit": 67108864,
      "ttlFrames": 300,
      "sweepEveryFrames": 30,
      "scratch": "fixed POD arrays; no scratch heap allocation",
      "currentFrameProtected": true,
      "incomingMaterialProtected": true,
      "failedPressureRetry": "at most one attempt per resource per frame; existing periodic/forced retirement is a separate path"
    },
    "fences": {
      "SurfaceResourceEpoch": "monotonic adapter cache mutation/retirement epoch, guarded by recursive mutex; independent of existing surface-role epoch and native object generation",
      "SurfaceMeshCurrent": "no API/no allocation; reject null, busy, pending retirement, unusable/missing mesh, optional material mismatch, missing/unusable owned material; not a durable handle lease"
    },
    "overlayBadAlloc": "SubmitSurfaceOverlay preserves submitted bool: bad_alloc before successful DrawInstance returns false; after successful DrawInstance returns true so caller cannot duplicate the D3D draw. The latter path is source-reviewed, not exercised by this CPU fixture.",
    "apiContractBoundary": "A failing Destroy is assumed not to have destroyed the handle, as in the existing backend. GPU/server behavior after a transport fault is outside this fixture."
